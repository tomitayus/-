#!/bin/bash
# ============================================================
#  当直くん - ダブルクリックで実行 (macOS用)
#
#  このファイルをダブルクリックするだけで当直表を生成できます。
#  初回実行時はPythonのセットアップが自動で行われます。
# ============================================================

# このファイルの場所に移動
cd "$(dirname "$0")"

# run.sh を実行
bash run.sh

# ウィンドウを閉じる前にキー入力を待つ
echo ""
echo "何かキーを押すとウィンドウを閉じます..."
read -n 1 -s
